{
  "name": "leaner",
  "version": "0.4.1",
  "description": "Thin, reactive wrapper for DOM",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "module": "./dist/core.js",
  "types": "./types/core.d.ts",
  "typesVersions": {
    "*": {
      "web": [
        "./types/web.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/core.js",
      "types": "./types/core.d.ts"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts"
    },
    "./web": {
      "import": "./dist/web.js",
      "types": "./types/web.d.ts"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaner-js/leaner.git"
  },
  "keywords": [
    "leaner",
    "javascript",
    "framework"
  ],
  "author": "Michał Męciński",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leaner-js/leaner/issues"
  },
  "homepage": "https://leanerjs.org/",
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "rollup": "^4.68.3",
    "vitest": "^5.1.0"
  }
}
