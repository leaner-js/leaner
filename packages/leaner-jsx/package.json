{
  "name": "leaner-jsx",
  "version": "0.1.0",
  "description": "JSX transformer for Leaner.js",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaner-js/leaner.git"
  },
  "keywords": [
    "leaner",
    "jsx",
    "vite-plugin",
    "rollup-plugin",
    "rolldown-plugin"
  ],
  "author": "Michał Męciński",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/leaner-js/leaner/issues"
  },
  "homepage": "https://leanerjs.org/",
  "dependencies": {
    "oxc-parser": "^0.143.0",
    "rolldown-string": "^0.3.1"
  },
  "devDependencies": {
    "rollup": "^4.40.1",
    "vitest": "^3.1.2"
  }
}
